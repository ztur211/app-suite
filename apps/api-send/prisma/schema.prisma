generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Things Send domain (things_send) ----
//
// Message represents an outbound or inbound communication that this user
// owns. P1 scope: drafts and outbound queue only — provider integrations
// (Gmail/Outlook/Slack/Discord/Telegram) land in a later phase. Inbound
// rows arrive via provider sync workers; outbound rows arrive either from
// the user composing in the app or from api-say parking a SEND intent as
// PENDING_SEND (future work). Auth tables live in things_auth (api-auth
// owns them); api-send reads sessions via the auth-client.
//
// channel values: 'email', 'slack', 'discord', 'telegram'
// kind values: 'outbound' (user → world), 'inbound' (world → user)
// status values for outbound: 'draft', 'sent'
// status values for inbound: 'unread', 'read', 'archived'

model Message {
  id String @id @default(cuid())
  // userId references things_auth.User.id. No FK constraint — cross-database
  // FKs aren't supported; integrity is enforced at the app layer.
  userId            String
  channel           String
  kind              String
  status            String
  subject           String?
  body              String
  recipient         String?
  sourceDictationId String?
  // Provider-assigned id of a sent message (e.g. Telegram message_id), if any.
  providerMessageId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, kind, status])
  @@index([userId, channel])
  @@index([userId, createdAt])
  @@index([userId, sourceDictationId])
}

// Maps a Things user to a Telegram chat (v1: one chat per user). Populated by
// the manual link endpoint; used to address outbound messages and to attribute
// inbound Telegram updates to the right user.
model TelegramLink {
  id       String   @id @default(cuid())
  userId   String   @unique
  chatId   String   @unique
  username String?
  linkedAt DateTime @default(now())

  @@index([chatId])
}

// Dedup log + cursor for Telegram getUpdates polling. update_id is globally
// monotonic per bot, so it both de-duplicates and advances the offset.
model TelegramInbound {
  id          String   @id @default(cuid())
  updateId    BigInt   @unique
  chatId      String
  // The inbound Message row created for this update, if the chat was linked.
  messageId   String?
  processedAt DateTime @default(now())

  @@index([chatId])
}
