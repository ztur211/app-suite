{
  "name": "@things/api-send",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "clean": "rimraf dist .tsbuildinfo",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "eslint src --max-warnings 0",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.integration.config.ts --passWithNoTests",
    "test:e2e": "jest --config jest.e2e.config.ts --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma/auth-schema.prisma",
    "db:push": "prisma db push --skip-generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.1.21",
    "@nestjs/platform-express": "^11.0.0",
    "@prisma/client": "^5.22.0",
    "@things/auth": "*",
    "@things/types": "*",
    "better-auth": "^1.6.11",
    "dotenv": "^16.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "@things/testing": "*",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
