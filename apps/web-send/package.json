{
  "name": "@things/web-send",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web",
    "build": "expo export -p web",
    "clean": "rimraf dist .expo .tsbuildinfo",
    "lint": "expo lint",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.ts",
    "test:integration": "jest --config jest.config.ts --testPathPattern=integration --passWithNoTests",
    "test:e2e": "echo 'web-send e2e via Playwright/Maestro added in P5' && exit 0",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@hookform/resolvers": "^3.10.0",
    "@things/design-system": "*",
    "@things/types": "*",
    "expo": "~55.0.24",
    "expo-constants": "~55.0.16",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-status-bar": "~55.0.6",
    "nativewind": "^4.2.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.76.1",
    "react-native": "0.85.3",
    "react-native-reanimated": "~3.16.7",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.25.0",
    "react-native-web": "~0.21.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@react-native/jest-preset": "0.85.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.1.1",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.0",
    "react-test-renderer": "19.2.6",
    "typescript": "^5.6.2"
  }
}
