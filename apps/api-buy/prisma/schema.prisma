generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Things Buy domain (things_buy) ----
//
// Shopping items either originate from a user manually adding one in web-buy
// or get pulled from api-say's PENDING_BUY queue (sourceDictationId set).
// Auth tables live in things_auth (api-auth owns them); api-buy reads sessions
// via the auth-client (see prisma/auth-schema.prisma).
//
// Status values: 'active' (not bought yet), 'bought' (user marked as done).

model ShoppingItem {
  id String @id @default(cuid())
  // userId references things_auth.User.id. No FK constraint — Postgres can't
  // enforce cross-database FKs, so referential integrity is the app layer's
  // responsibility (User deletion ultimately cleans up via an app-level
  // tombstone or a periodic GC; not yet implemented).
  userId            String
  title             String
  quantity          Int?
  notes             String?
  status            String   @default("active")
  sourceDictationId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([userId, sourceDictationId])
}
