generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Things Eat domain (things_eat) ----
//
// MealItem either originates from a user manually adding one or gets pulled
// from api-say's PENDING_EAT queue. kind reflects whether the item is a
// recipe to cook, a restaurant to visit, or an "either" preference that
// could become either later. Auth tables live in things_auth (api-auth owns
// them); api-eat reads sessions via the auth-client (see prisma/auth-schema.prisma).
//
// kind values: 'recipe', 'restaurant', 'either'
// status values: 'active' (planned), 'tried' (done)

model MealItem {
  id String @id @default(cuid())
  // userId references things_auth.User.id. No FK constraint — cross-database
  // FKs aren't supported; integrity is enforced at the app layer.
  userId            String
  name              String
  kind              String
  notes             String?
  status            String   @default("active")
  sourceDictationId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, kind])
  @@index([userId, createdAt])
  @@index([userId, sourceDictationId])
}
