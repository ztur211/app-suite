generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Things Say domain (things_say) ----
//
// Auth tables live in things_auth (api-auth owns them); api-say reads sessions
// via the auth-client (see prisma/auth-schema.prisma).
//
// Enum-like columns (intent/destination/state/captureMode) and Json columns
// (proposedPayload/editedPayload/usage) are still typed as String because the
// app uses JSON.stringify/parse and Zod validation today. A follow-up commit
// will switch them to native Postgres enums and Json once the tests are
// updated to match.
//
// Intent values:          DO, NOTE, SEND, BUY, EAT
// DictationState values:  proposed, confirmed, dispatched, cancelled
// Destination values:     DO_THINGS, SAY_LIBRARY, CLIPBOARD, PENDING_BUY, PENDING_EAT
// CaptureMode values:     tap, drive, type

model Dictation {
  id String @id @default(cuid())
  // userId references things_auth.User.id (no cross-DB FK).
  userId String

  audioPath         String?
  previewTranscript String?
  finalTranscript   String
  language          String
  captureMode       String  @default("tap")

  intent          String
  confidence      Float
  proposedPayload String
  editedPayload   String?

  state          String    @default("proposed")
  destination    String
  destinationRef String?
  dispatchedAt   DateTime?
  cancelledAt    DateTime?

  usage String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, intent, state])
  @@index([destination, state])
}

model IdempotencyKey {
  key             String @id
  userId          String
  endpoint        String
  requestBodyHash String
  statusCode      Int
  responseBody    String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([expiresAt])
  @@index([userId, endpoint, createdAt])
}

// ---- AI usage audit (per foundation spec §5.2) ----
// Written by api-say's PrismaUsageLogger via the domain client. The
// foundation spec calls AiCall a "cross-app cost center"; each consumer app
// keeps its own copy in its own DB. Reporting aggregates across apps.

model AiCall {
  id               String   @id @default(cuid())
  userId           String?
  callerApp        String
  operation        String
  provider         String
  model            String
  inputTokens      Int?
  outputTokens     Int?
  cacheReadTokens  Int?
  cacheWriteTokens Int?
  audioSeconds     Float?
  vectorCount      Int?
  durationMs       Int
  fellBackTo       String?
  startedAt        DateTime
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([callerApp, createdAt])
}
