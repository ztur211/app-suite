generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Things Do domain (things_do) ----
// Auth tables live in things_auth (api-auth owns them). api-do reads sessions
// via the auth-client (see prisma/auth-schema.prisma) and writes Task rows
// here via this client.

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  completed Boolean   @default(false)
  dueAt     DateTime?
  // Optional cross-app provenance pointer (e.g. the dictation that created
  // this task). Native Json now that we're on Postgres.
  source    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, completed])
  @@index([userId, createdAt])
}
