# Production environment for docker-compose.prod.yml.
#
# Copy to infra/.env on the VPS and fill in real values. infra/.env is
# gitignored and should be root-owned, mode 600 (foundation spec §10).
#
#   cp infra/.env.example infra/.env && chmod 600 infra/.env
#
# Generate strong secrets with:  openssl rand -base64 36

# --- Image source ------------------------------------------------------------
# GHCR namespace the deploy workflow pushes to. TAG is set per-deploy (the
# commit SHA); leave 'latest' for manual bring-up.
REGISTRY=ghcr.io/ztur211
TAG=latest

# --- Public domain + TLS -----------------------------------------------------
# Apex domain only (no scheme). Subdomains are derived: auth.<domain>,
# api.<app>.<domain>, <app>.<domain>.
THINGS_DOMAIN=things.app
# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=ops@things.app

# Parent cookie domain for cross-subdomain sessions (Better Auth crossSubDomainCookies).
# Leading dot. Prod: .things.app   Local: .things.test   (leave blank to disable)
AUTH_COOKIE_DOMAIN=.things.app

# Extra browser origins allowed to call the APIs (CORS + Better Auth trustedOrigins),
# comma-separated, with scheme. Use this for web apps hosted off $THINGS_DOMAIN —
# e.g. the Vercel deployments, which are cross-site and use Bearer-token auth.
# See infra/VERCEL.md. Leave blank if all web apps live under $THINGS_DOMAIN.
WEB_ORIGINS=https://things-do.vercel.app,https://things-say.vercel.app,https://things-buy.vercel.app,https://things-eat.vercel.app,https://things-send.vercel.app
# Local single-machine deploy only: set to `local_certs` to use Caddy's internal CA
# instead of Let's Encrypt. Leave blank in production.
CADDY_EXTRA_GLOBAL=

# --- Postgres superuser + per-app role passwords -----------------------------
# init-prod.sh creates the per-app owner roles + auth_reader with these. The
# DATABASE_URLs in docker-compose.prod.yml reference the SAME values, so they
# must match exactly.
POSTGRES_PASSWORD=change-me-superuser
AUTH_OWNER_PASSWORD=change-me-auth-owner
DO_OWNER_PASSWORD=change-me-do-owner
SAY_OWNER_PASSWORD=change-me-say-owner
BUY_OWNER_PASSWORD=change-me-buy-owner
EAT_OWNER_PASSWORD=change-me-eat-owner
SEND_OWNER_PASSWORD=change-me-send-owner
AUTH_READER_PASSWORD=change-me-auth-reader

# --- App secrets -------------------------------------------------------------
# Better Auth session signing secret — MUST be identical across every app so
# sessions issued by api-auth validate everywhere (>= 32 chars recommended).
BETTER_AUTH_SECRET=change-me-better-auth-secret-min-32-chars
# HMAC secret for service-to-service JWTs (@things/auth/service-jwt).
SERVICE_TOKEN_SECRET=change-me-service-token-secret

# --- AI providers (api-say) --------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# --- Backups (infra/backup/backup.sh) ----------------------------------------
# Optional: rclone remote for off-box copies. Leave blank for local-only.
# RCLONE_REMOTE=b2:things-backups
# BACKUP_DIR=/var/backups/things
